{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs", // <-- This is correct for your goal
    "rootDir": "./src",
    "moduleResolution": "node", // <-- This is correct for CommonJS
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}